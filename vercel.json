{
  "functions": {
    "app/**/*": {
      "maxDuration": 100
    }
  },
  "crons": [
    {
      "path": "/api/cron/morning/storageCleanup",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/morning/sanctionFestivalCounting",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/morning/programHoldExpiration",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/morning/programSessionReminders",
      "schedule": "0 14 * * *"
    }
  ]
}
